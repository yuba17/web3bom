{
  "components": [
    "Vault"
  ],
  "is_pre_production": false,
  "lang": "solidity",
  "protocol": "yieldoor",
  "steps": [
    {
      "depends_on": [],
      "description": "Run detection engine prepass for Vault",
      "id": "Vault:prepass",
      "retry": 1,
      "type": "bash"
    },
    {
      "depends_on": [
        "Vault:prepass"
      ],
      "description": "Check if Chimera Setup exists and build early setup prompt for Vault",
      "id": "Vault:chimera_early_check",
      "timeout": 60,
      "type": "generate"
    },
    {
      "depends_on": [
        "Vault:chimera_early_check"
      ],
      "description": "Generate early Chimera Setup for Vault (hunter context)",
      "id": "Vault:chimera_early_setup",
      "prompt": "__DYNAMIC__",
      "retry": 1,
      "timeout": 1200,
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash"
      ],
      "type": "agent"
    },
    {
      "depends_on": [
        "Vault:chimera_early_setup"
      ],
      "description": "Build hunter brief and dispatch prompt for Vault",
      "id": "Vault:build_hunter_prompt",
      "timeout": 60,
      "type": "generate"
    },
    {
      "depends_on": [
        "Vault:build_hunter_prompt"
      ],
      "description": "Run 12 parallel hunters for Vault",
      "id": "Vault:hunters",
      "prompt": "__DYNAMIC__",
      "retry": 1,
      "timeout": 1800,
      "tools": [
        "Agent",
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob"
      ],
      "type": "agent"
    },
    {
      "depends_on": [
        "Vault:hunters"
      ],
      "description": "Build DeepDive prompt for Vault",
      "id": "Vault:build_deepdive_prompt",
      "timeout": 60,
      "type": "generate"
    },
    {
      "depends_on": [
        "Vault:build_deepdive_prompt"
      ],
      "description": "DeepDive analysis for Vault",
      "id": "Vault:deepdive",
      "prompt": "__DYNAMIC__",
      "retry": 1,
      "timeout": 1800,
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob"
      ],
      "type": "agent"
    },
    {
      "depends_on": [
        "Vault:deepdive"
      ],
      "description": "Check if full Chimera Setup needed and build prompt for Vault",
      "id": "Vault:chimera_builder_check",
      "timeout": 60,
      "type": "generate"
    },
    {
      "depends_on": [
        "Vault:chimera_builder_check"
      ],
      "description": "Generate/verify Chimera Setup for Vault (pre-merge)",
      "id": "Vault:chimera_builder",
      "prompt": "__DYNAMIC__",
      "retry": 1,
      "timeout": 1200,
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Bash"
      ],
      "type": "agent"
    },
    {
      "depends_on": [
        "Vault:chimera_builder"
      ],
      "description": "Merge invariants for Vault",
      "id": "Vault:merge",
      "type": "bash"
    },
    {
      "depends_on": [
        "Vault:merge"
      ],
      "description": "forge build for Vault",
      "id": "Vault:compile",
      "retry": 3,
      "timeout": 300,
      "type": "bash"
    },
    {
      "depends_on": [
        "Vault:compile"
      ],
      "description": "Check compile result and emit fuzz steps for Vault",
      "id": "Vault:post_compile",
      "timeout": 60,
      "type": "generate"
    },
    {
      "depends_on": [
        "Vault:post_compile"
      ],
      "description": "Collect and process findings for Vault",
      "id": "Vault:collect_findings",
      "timeout": 60,
      "type": "generate"
    },
    {
      "depends_on": [
        "Vault:collect_findings"
      ],
      "description": "Write checkpoint for Vault",
      "id": "Vault:checkpoint",
      "timeout": 30,
      "type": "bash"
    },
    {
      "depends_on": [
        "Vault:checkpoint"
      ],
      "description": "Score findings against ground truth",
      "id": "scoring",
      "type": "bash"
    }
  ],
  "version": "1.0.0"
}
